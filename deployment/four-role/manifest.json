    "rollback": "route to unchanged OFF baseline; stop new candidate; preserve permanent ledgers and evidence"
  },
  "approvalStages": {
    "next": "SOURCE+FOUR_NEW_BUILDS/PUSH_EVIDENCE ONLY, NOT AUTHORIZED HERE",
