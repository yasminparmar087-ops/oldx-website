# C1A private OFF-only Gateway. Build context: repository root.
# Official nonroot linux/amd64 manifest/config metadata SHA256 checked 2026-11-24.
# Candidate only: publisher signature, derived build, SBOM and scan still pending.
# No mutable tag, build ARG override, builder stage, package install or shell.
FROM --platform=linux/amd64 gcr.io/distroless/nodejs24-debian13:nonroot@sha256:49559f4ee6632a11a13a7e198183efee1226de7a8f437df83c180b01bd8253ec
WORKDIR /app
ENV NODE_ENV=production
COPY --chown=65532:65532 --chmod=0444 functions/staging-marketplace/cloud-run-gateway-off-server.mjs /app/server.mjs
USER 65532:65532
EXPOSE 8080
STOPSIGNAL SIGTERM
ENTRYPOINT ["/nodejs/bin/node"]
CMD ["server.mjs"]
